# ==============================================================================
# Colab Model Station - Environment Configuration Template
# ==============================================================================

# Tailscale Mesh Networking
# Ephemeral or reusable Auth Key generated from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY="tskey-auth-kXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TAILSCALE_HOSTNAME="colab-model-station"

# Hugging Face Authentication Token (Required for gated models such as FLUX.1-dev)
HF_TOKEN=""

# Google Colab CLI Authentication Mode (options: oauth2, service_account)
COLAB_AUTH="oauth2"

# Remote Inference Configuration
# Engine selection: diffusers | comfyui
STATION_ENGINE="diffusers"

# Target model identifier (HF repo ID or local path)
# Examples:
#   black-forest-labs/FLUX.1-schnell
#   black-forest-labs/FLUX.1-dev
#   stabilityai/stable-diffusion-xl-base-1.0
STATION_MODEL="black-forest-labs/FLUX.1-schnell"

# Target precision: fp8 | fp16 | bf16 | auto
STATION_PRECISION="fp8"

# Port configurations
DIFFUSERS_PORT=8000
COMFYUI_PORT=8188

# Compute Unit Protection: Idle timeout in seconds before unassigning Colab runtime
IDLE_TIMEOUT_SECONDS=1800

# Optional persistent cache directory on Google Drive (Leave empty to use ephemeral local disk)
DRIVE_CACHE_DIR=""
