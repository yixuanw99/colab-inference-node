{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "catalogs": {
    "diffusion": {
      "default_model": "black-forest-labs/FLUX.1-schnell",
      "models": {
        "black-forest-labs/FLUX.1-schnell": {
          "name": "FLUX.1 [schnell]",
          "family": "flux",
          "pipeline_type": "FluxPipeline",
          "description": "12B parameter flow transformer for 1-4 step generation.",
          "license": "apache-2.0",
          "default_steps": 4,
          "default_guidance_scale": 0.0,
          "supports_lora": true,
          "hardware": {
            "t4": {"precision": "fp8", "offload": "sequential"},
            "l4": {"precision": "fp8", "offload": "model"},
            "a100": {"precision": "bf16", "offload": "none"}
          }
        },
        "black-forest-labs/FLUX.1-dev": {
          "name": "FLUX.1 [dev]",
          "family": "flux",
          "pipeline_type": "FluxPipeline",
          "description": "12B parameter photorealistic guidance-distilled model.",
          "license": "non-commercial",
          "gated": true,
          "default_steps": 28,
          "default_guidance_scale": 3.5,
          "supports_lora": true,
          "hardware": {
            "t4": {"precision": "fp8", "offload": "sequential"},
            "l4": {"precision": "fp8", "offload": "model"},
            "a100": {"precision": "bf16", "offload": "none"}
          }
        },
        "black-forest-labs/FLUX.2-dev": {
          "name": "FLUX.2 [dev]",
          "family": "flux2",
          "pipeline_type": "Flux2Pipeline",
          "description": "Next-gen flow transformer with Mistral-3 conditioning.",
          "license": "non-commercial",
          "gated": true,
          "default_steps": 50,
          "default_guidance_scale": 4.0,
          "supports_lora": true,
          "hardware": {
            "a100": {"precision": "bf16", "offload": "model"}
          }
        },
        "stabilityai/stable-diffusion-xl-base-1.0": {
          "name": "Stable Diffusion XL Base 1.0",
          "family": "sdxl",
          "pipeline_type": "StableDiffusionXLPipeline",
          "description": "Flagship 3.5B latent diffusion model.",
          "license": "openrail++",
          "default_steps": 30,
          "default_guidance_scale": 7.5,
          "supports_lora": true,
          "hardware": {
            "t4": {"precision": "fp16", "offload": "model"},
            "l4": {"precision": "fp16", "offload": "none"},
            "a100": {"precision": "fp16", "offload": "none"}
          }
        }
      },
      "lora_examples": [
        {
          "name": "flux-realism-lora",
          "target_family": "flux",
          "repo_id": "XLabs-AI/flux-RealismLora",
          "recommended_scale": 0.85
        },
        {
          "name": "sdxl-offset-lora",
          "target_family": "sdxl",
          "repo_id": "neroger/pixel-art-xl",
          "recommended_scale": 0.80
        }
      ]
    },
    "llm": {
      "vllm": {
        "models": {
          "Qwen/Qwen2.5-Coder-7B-Instruct-AWQ": {
            "vram_gb": 8.0,
            "quantization": "awq",
            "context_length": 32768,
            "description": "Optimal 7B code model for T4/L4 high-throughput serving."
          },
          "Qwen/Qwen2.5-Coder-14B-Instruct-AWQ": {
            "vram_gb": 12.0,
            "quantization": "awq",
            "context_length": 32768,
            "description": "Balanced coding model for L4 (24GB VRAM)."
          },
          "Qwen/Qwen2.5-Coder-32B-Instruct-AWQ": {
            "vram_gb": 22.0,
            "quantization": "awq",
            "context_length": 32768,
            "description": "High capability 32B model fitting L4 (24GB) or A100."
          },
          "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B": {
            "vram_gb": 65.0,
            "quantization": "none",
            "context_length": 32768,
            "description": "Full bfloat16 reasoning model for A100 (80GB)."
          }
        }
      },
      "ollama": {
        "models": {
          "qwen2.5-coder:7b": {
            "vram_gb": 6.5,
            "format": "GGUF Q4_K_M",
            "description": "Fast and lightweight coding assistant for T4."
          },
          "qwen2.5-coder:14b": {
            "vram_gb": 11.0,
            "format": "GGUF Q4_K_M",
            "description": "Intermediate coding model for T4/L4."
          },
          "qwen2.5-coder:32b": {
            "vram_gb": 20.0,
            "format": "GGUF Q4_K_M",
            "description": "Top-tier open-source coding engine for L4."
          },
          "deepseek-r1:8b": {
            "vram_gb": 7.0,
            "format": "GGUF Q4_K_M",
            "description": "Reasoning distilled model for T4."
          },
          "deepseek-r1:32b": {
            "vram_gb": 21.0,
            "format": "GGUF Q4_K_M",
            "description": "Flagship 32B reasoning model on L4."
          }
        }
      }
    },
    "vlm": {
      "default_model": "Qwen/Qwen2-VL-2B-Instruct",
      "models": {
        "Qwen/Qwen2-VL-2B-Instruct": {
          "vram_gb": 4.5,
          "description": "High-efficiency vision-language model for OCR and visual reasoning."
        },
        "Qwen/Qwen2-VL-7B-Instruct": {
          "vram_gb": 16.0,
          "description": "Flagship 7B multimodal model for document parsing and reasoning."
        }
      }
    },
    "audio": {
      "default_model": "openai/whisper-tiny",
      "models": {
        "openai/whisper-tiny": {
          "vram_gb": 1.0,
          "description": "Ultra-fast speech-to-text transcription engine."
        },
        "openai/whisper-large-v3": {
          "vram_gb": 10.0,
          "description": "High-accuracy multilingual speech recognition."
        }
      }
    },
    "embedding": {
      "default_model": "sentence-transformers/all-MiniLM-L6-v2",
      "models": {
        "sentence-transformers/all-MiniLM-L6-v2": {
          "vram_gb": 0.5,
          "dimension": 384,
          "description": "Lightweight dense sentence embedding model (8000+ sent/s)."
        },
        "BAAI/bge-m3": {
          "vram_gb": 2.5,
          "dimension": 1024,
          "description": "Multilingual multi-functionality embedding engine."
        }
      }
    },
    "video": {
      "default_model": "THUDM/CogVideoX-2b",
      "models": {
        "THUDM/CogVideoX-2b": {
          "vram_gb": 18.0,
          "description": "High-fidelity 2B parameter text-to-video diffusion model."
        }
      }
    }
  }
}
